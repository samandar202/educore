POSTGRES_PASSWORD=change_this_local_password
DATABASE_URL=postgres://educore:change_this_local_password@127.0.0.1:5432/educore
BIND_ADDR=127.0.0.1:3000
COOKIE_SECURE=false

# V4 additions. Existing V3 .env files also work with defaults.
DB_POOL_SIZE=10
MEDIA_DIR=data/media
MEDIA_QUOTA_MB=200
APP_BASE_URL=http://127.0.0.1:3000
MAIL_MODE=disabled
MAIL_DIR=data/mail
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=academy@example.com
# SMTP_USER=academy@example.com
# SMTP_PASSWORD=your_provider_password

# Local audio is the default. Render instructions: CLOUD_DEPLOY.md.
MEDIA_BACKEND=local
REGISTRATION_ENABLED=true
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_KEY
# SUPABASE_STORAGE_BUCKET=educore-audio
# Render: leave BIND_ADDR unset; PORT is supplied automatically.

# Server-side Groq key. Free plan has provider limits; an empty key disables AI.
AI_PROVIDER=groq
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_DAILY_LIMIT=10
# Optional paid Claude provider: AI_PROVIDER=anthropic, AI_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=
